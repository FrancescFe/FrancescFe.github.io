---
import * as reportCover from "../../../../content/project-report/00-cover-toc-abstract.md";
import PageContainer from "../../../../components/PageContainer.astro";
import TextLink from "../../../../components/TextLink.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";

interface MarkdownModule {
  compiledContent: () => Promise<string>;
  getHeadings: () => Promise<Array<{ depth: number; text: string }>>;
}

const canonicalPath = "/projects/book-publishing/project-report/";
const title = "Project Report — Book Publishing Platform | FrancescFe";
const description =
  "Project report on the design and implementation of a back-office system for publishing management.";

const source = reportCover.rawContent();
const cover = source.split(/^## Table of Contents\s*$/m, 1)[0] ?? "";
const abstract = source.split(/^## Abstract\s*$/m)[1]?.trim() ?? "";

const reportTitle = cover.match(/^#\s+(.+)$/m)?.[1] ?? "Project Report";
const reportSubtitle = cover.match(/^##\s+(.+)$/m)?.[1] ?? "";
const author = cover.match(/^\*\*Author:\*\*\s*(.+)$/m)?.[1] ?? "";
const version = cover.match(/^\*\*Version:\*\*\s*(.+)$/m)?.[1] ?? "";
const reportDate = cover.match(/^\*\*Date:\*\*\s*(.+)$/m)?.[1] ?? "";

const chapterFiles = Object.entries(
  import.meta.glob<MarkdownModule>("../../../../content/project-report/*.md", {
    eager: true,
  }),
)
  .filter(([path]) => !path.endsWith("/00-cover-toc-abstract.md"))
  .sort(([leftPath], [rightPath]) => leftPath.localeCompare(rightPath));

const chapters = await Promise.all(
  chapterFiles.map(async ([path, chapter]) => {
    const headings = await chapter.getHeadings();
    const heading = headings.find(({ depth }) => depth === 1) ?? headings[0];
    const renderedContent = await chapter.compiledContent();
    const contentWithoutTitle = renderedContent.replace(
      /^\s*<h1\b[^>]*>[\s\S]*?<\/h1>\s*/i,
      "",
    );
    const content = contentWithoutTitle.replace(
      /<(\/?)h([1-5])(?=[\s>])/g,
      (_match, closingTag: string, level: string) =>
        `<${closingTag}h${Number(level) + 1}`,
    );

    return {
      content,
      slug: path.split("/").at(-1)?.replace(/\.md$/, "") ?? "chapter",
      title: heading?.text ?? "Project report chapter",
    };
  }),
);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  currentPath={canonicalPath}
  headerVariant="compact"
  footerVariant="minimal"
>
  <PageContainer>
    <article class="project-report" aria-labelledby="project-report-title">
      <nav class="project-report__breadcrumb" aria-label="Breadcrumb">
        <TextLink href="/projects/book-publishing/" variant="standalone">
          ← Book Publishing Platform
        </TextLink>
      </nav>

      <header class="project-report__cover">
        <p class="project-report__eyebrow">[ project / report ]</p>
        <h1 id="project-report-title">{reportTitle}</h1>
        <p class="project-report__subtitle">{reportSubtitle}</p>

        <dl class="project-report__metadata" aria-label="Report details">
          <div>
            <dt>Author</dt>
            <dd>{author}</dd>
          </div>
          <div>
            <dt>Version</dt>
            <dd>{version}</dd>
          </div>
          <div>
            <dt>Date</dt>
            <dd>{reportDate}</dd>
          </div>
        </dl>
      </header>

      <section
        class="project-report__abstract"
        aria-labelledby="abstract-title"
      >
        <h2 id="abstract-title">Abstract</h2>
        <p>{abstract}</p>
      </section>

      <section
        class="project-report__chapters"
        aria-label="Project report chapters"
      >
        {
          chapters.map((chapter) => (
            <details
              id={`chapter-${chapter.slug}`}
              class="project-report__chapter"
            >
              <summary>
                <h2>{chapter.title}</h2>
              </summary>
              <div
                class="project-report__chapter-content"
                set:html={chapter.content}
              />
            </details>
          ))
        }
      </section>
    </article>
  </PageContainer>
</BaseLayout>

<style>
  .project-report {
    max-inline-size: var(--content-reading-max);
    margin-inline: auto;
    padding-block: var(--space-8) var(--space-12);
  }

  .project-report__breadcrumb {
    margin-block-end: var(--space-8);
  }

  .project-report__cover {
    display: grid;
    gap: var(--space-4);
    padding-block-end: var(--space-8);
    border-block-end: var(--border-default) var(--color-border-subtle);
  }

  .project-report__eyebrow {
    color: var(--color-text-tertiary);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--letter-spacing-uppercase);
    line-height: var(--type-label-line-height);
    text-transform: uppercase;
  }

  .project-report h1 {
    max-inline-size: 24ch;
  }

  .project-report__subtitle {
    max-inline-size: 64ch;
    color: var(--color-text-secondary);
    font-size: var(--type-title-size);
    line-height: var(--type-h3-line-height);
  }

  .project-report__metadata {
    display: grid;
    max-inline-size: 760px;
    margin: var(--space-3) 0 0;
    border-block-start: var(--border-default) var(--color-border-subtle);
  }

  .project-report__metadata > div {
    display: grid;
    grid-template-columns: minmax(96px, 0.3fr) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-block-end: var(--border-default) var(--color-border-subtle);
  }

  .project-report__metadata dt {
    color: var(--color-text-tertiary);
    font-size: var(--type-meta-size);
    font-weight: var(--type-meta-weight);
    line-height: var(--type-meta-line-height);
  }

  .project-report__metadata dd {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--type-body-sm-size);
    line-height: var(--type-body-sm-line-height);
  }

  .project-report__abstract {
    display: grid;
    max-inline-size: var(--content-prose-max);
    gap: var(--space-4);
    padding-block-start: var(--space-8);
  }

  .project-report__abstract h2 {
    font-size: var(--type-h3-size);
    line-height: var(--type-h3-line-height);
  }

  .project-report__abstract p {
    color: var(--color-text-secondary);
  }

  .project-report__chapters {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-10);
  }

  .project-report__chapter {
    overflow: clip;
    border: var(--border-default) var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-surface-default);
  }

  .project-report__chapter[open] {
    border-color: var(--color-border-strong);
  }

  .project-report__chapter summary {
    display: flex;
    min-block-size: var(--interactive-target-min);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  .project-report__chapter summary::-webkit-details-marker {
    display: none;
  }

  .project-report__chapter summary::after {
    flex: 0 0 auto;
    color: var(--color-accent-default);
    content: "+";
    font-size: var(--type-h3-size);
    line-height: var(--type-h3-line-height);
  }

  .project-report__chapter[open] summary::after {
    content: "−";
  }

  .project-report__chapter summary:hover {
    background: var(--color-surface-hover);
  }

  .project-report__chapter summary h2 {
    font-size: var(--type-h3-size);
    line-height: var(--type-h3-line-height);
  }

  .project-report__chapter-content {
    min-inline-size: 0;
    padding: var(--space-5);
    border-block-start: var(--border-default) var(--color-border-subtle);
  }

  .project-report__chapter-content :global(p) {
    max-inline-size: var(--content-prose-max);
    margin-block-end: var(--space-4);
    color: var(--color-text-secondary);
  }

  .project-report__chapter-content :global(ul),
  .project-report__chapter-content :global(ol) {
    display: grid;
    max-inline-size: var(--content-prose-max);
    gap: var(--space-3);
    margin-block: var(--space-4);
    padding-inline-start: var(--space-6);
    color: var(--color-text-secondary);
  }

  .project-report__chapter-content :global(strong) {
    color: var(--color-text-primary);
  }

  .project-report__chapter-content :global(code:not(pre code)) {
    padding-inline: var(--space-1);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
  }

  .project-report__chapter-content :global(pre) {
    max-inline-size: 100%;
    margin-block: var(--space-4);
    padding: var(--space-4);
    border: var(--border-default) var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-bg-deep);
    color: var(--color-text-primary);
    overflow-x: auto;
  }

  .project-report__chapter-content :global(table) {
    display: block;
    max-inline-size: 100%;
    margin-block: var(--space-4);
    overflow-x: auto;
  }

  .project-report__chapter-content :global(th),
  .project-report__chapter-content :global(td) {
    padding: var(--space-2) var(--space-3);
    border: var(--border-default) var(--color-border-subtle);
    text-align: start;
    vertical-align: top;
  }

  .project-report__chapter-content :global(img) {
    max-inline-size: 100%;
    block-size: auto;
    margin-block: var(--space-4);
    border-radius: var(--radius-md);
  }
</style>
