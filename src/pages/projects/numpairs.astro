---
import PageContainer from "../../components/PageContainer.astro";
import TextLink from "../../components/TextLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const canonicalPath = "/projects/numpairs/";
const title = "NumPairs — Android puzzle game | FrancescFe";
const description =
  "NumPairs is an open-source Android arithmetic deduction puzzle built with Kotlin and Jetpack Compose, with a domain model for generated puzzles and local sessions.";
const sourceUrl = "https://github.com/CescFe/numpairs";

const sections = [
  { id: "product", label: "The product" },
  { id: "implementation", label: "Android implementation" },
  { id: "domain", label: "Domain model" },
  { id: "generation", label: "Puzzle generation" },
  { id: "delivery", label: "Persistence and delivery" },
] as const;

const architectureLayers = [
  {
    name: "domain",
    description:
      "Puzzle models, rules, assignments, validation, and generation.",
  },
  {
    name: "data",
    description:
      "Seed puzzles, preferences, generated sessions, and Daily state.",
  },
  {
    name: "feature",
    description: "Menu, tutorials, play modes, routes, and presentation state.",
  },
  {
    name: "ui",
    description: "Navigation composition, themes, and shared visual defaults.",
  },
] as const;

const generatedProfiles = [
  "3 Pairs Low",
  "3 Pairs Medium",
  "4 Pairs Low",
  "4 Pairs Medium",
  "8 Pairs Medium",
  "8 Pairs Hard",
] as const;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  currentPath={canonicalPath}
  headerVariant="compact"
  footerVariant="minimal"
  showScrollToTop
  social={{ title, description, type: "article" }}
>
  <div class="case-study-page">
    <PageContainer>
      <article class="case-study" aria-labelledby="case-study-title">
        <header class="case-study__hero">
          <div class="case-study__hero-content">
            <p class="case-study__eyebrow">[ project / android ]</p>
            <p class="case-study__category">
              Open-source arithmetic deduction puzzle
            </p>
            <h1 id="case-study-title">NumPairs</h1>
            <p class="case-study__lead">
              NumPairs is a native Android puzzle where players complete hidden
              expressions by deducing how numbers from a strip pair across a
              result grid.
            </p>

            <div class="case-study__actions" aria-label="NumPairs actions">
              <TextLink
                href={sourceUrl}
                variant="navigation"
                target="_blank"
                rel="noreferrer"
              >
                View source repository <span aria-hidden="true">↗</span>
              </TextLink>
              <TextLink href="/numpairs/privacy-policy/" variant="navigation">
                Read the Privacy Policy
              </TextLink>
            </div>
          </div>

          <dl
            class="case-study__metadata"
            aria-label="NumPairs project metadata"
          >
            <div>
              <dt>Platform</dt>
              <dd>Android</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>Kotlin · Jetpack Compose</dd>
            </div>
            <div>
              <dt>Distribution</dt>
              <dd>Google Play release path in progress</dd>
            </div>
            <div>
              <dt>License</dt>
              <dd>MIT</dd>
            </div>
          </dl>
        </header>

        <figure class="case-study__visual">
          <svg
            role="img"
            aria-labelledby="puzzle-visual-title puzzle-visual-description"
            viewBox="0 0 1200 480"
            xmlns="http://www.w3.org/2000/svg"
          >
            <title id="puzzle-visual-title">NumPairs puzzle anatomy</title>
            <desc id="puzzle-visual-description">
              An illustrative number strip feeds a result grid. A pair such as 2
              and 3 creates an addition result of 5 and a multiplication result
              of 6.
            </desc>
            <rect width="1200" height="480" rx="12" fill="var(--color-bg-deep)"
            ></rect>
            <text
              x="64"
              y="68"
              fill="var(--color-text-secondary)"
              font-family="var(--font-family-mono)"
              font-size="18"
              font-weight="700"
              letter-spacing="1.2"
            >
              PUZZLE LOOP
            </text>
            <g transform="translate(64 112)">
              <rect
                width="380"
                height="260"
                rx="8"
                fill="var(--color-surface-default)"
                stroke="var(--color-border-strong)"></rect>
              <text
                x="28"
                y="48"
                fill="var(--color-text-secondary)"
                font-family="var(--font-family-mono)"
                font-size="16"
                font-weight="700"
              >
                NUMBER STRIP
              </text>
              <text
                x="28"
                y="112"
                fill="var(--color-text-primary)"
                font-family="var(--font-family-mono)"
                font-size="30"
                font-weight="700"
              >
                1 2 ? 4 4 ? 7 9
              </text>
              <line
                x1="28"
                y1="144"
                x2="352"
                y2="144"
                stroke="var(--color-border-subtle)"></line>
              <text
                x="28"
                y="190"
                fill="var(--color-text-secondary)"
                font-family="var(--font-family-mono)"
                font-size="16"
              >
                hidden values are deduced
              </text>
              <text
                x="28"
                y="222"
                fill="var(--color-accent-default)"
                font-family="var(--font-family-mono)"
                font-size="16"
                font-weight="700"
              >
                stable entry identity
              </text>
            </g>
            <path
              d="M480 242H642"
              fill="none"
              stroke="var(--color-accent-default)"
              stroke-width="3"></path>
            <path
              d="m626 226 20 16-20 16"
              fill="none"
              stroke="var(--color-accent-default)"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <text
              x="522"
              y="214"
              fill="var(--color-text-secondary)"
              font-family="var(--font-family-mono)"
              font-size="15"
              text-anchor="middle"
            >
              pair facts
            </text>
            <g transform="translate(704 112)">
              <rect
                width="432"
                height="260"
                rx="8"
                fill="var(--color-surface-default)"
                stroke="var(--color-border-strong)"></rect>
              <text
                x="28"
                y="48"
                fill="var(--color-text-secondary)"
                font-family="var(--font-family-mono)"
                font-size="16"
                font-weight="700"
              >
                RESULT GRID
              </text>
              <rect
                x="28"
                y="76"
                width="172"
                height="136"
                rx="6"
                fill="var(--color-surface-raised)"
                stroke="var(--color-border-subtle)"></rect>
              <text
                x="114"
                y="126"
                fill="var(--color-text-primary)"
                font-family="var(--font-family-mono)"
                font-size="22"
                text-anchor="middle"
              >
                ? + ?
              </text>
              <text
                x="114"
                y="174"
                fill="var(--color-accent-default)"
                font-family="var(--font-family-mono)"
                font-size="28"
                font-weight="700"
                text-anchor="middle"
              >
                5
              </text>
              <rect
                x="228"
                y="76"
                width="176"
                height="136"
                rx="6"
                fill="var(--color-surface-raised)"
                stroke="var(--color-border-subtle)"></rect>
              <text
                x="316"
                y="126"
                fill="var(--color-text-primary)"
                font-family="var(--font-family-mono)"
                font-size="22"
                text-anchor="middle"
              >
                ? × ?
              </text>
              <text
                x="316"
                y="174"
                fill="var(--color-accent-default)"
                font-family="var(--font-family-mono)"
                font-size="28"
                font-weight="700"
                text-anchor="middle"
              >
                6
              </text>
              <text
                x="28"
                y="238"
                fill="var(--color-text-secondary)"
                font-family="var(--font-family-mono)"
                font-size="15"
              >
                one pair → one sum + one product
              </text>
            </g>
          </svg>
          <figcaption>
            An illustrative view of the core rule: a solution pair contributes
            one addition tile and one multiplication tile.
          </figcaption>
        </figure>

        <div class="case-study__body">
          <div class="case-study__main">
            <section
              id="product"
              class="case-study__section"
              aria-labelledby="product-title"
            >
              <p class="case-study__section-label">01 / product</p>
              <h2 id="product-title">A puzzle built around deduction</h2>
              <div class="case-study__prose">
                <p>
                  NumPairs turns arithmetic into a constraint-solving puzzle.
                  The player sees a strip of positive integers in ascending
                  order and a board of visible results. The expressions that
                  produced those results are hidden, so progress comes from
                  finding consistent pairings rather than guessing a sequence of
                  moves.
                </p>
                <p>
                  Each solution pair is used twice: once to produce a sum and
                  once to produce a product. For example, the pair
                  <code>(2, 3)</code> accounts for result tiles <code>5</code>
                  and <code>6</code>. A strip entry is a distinct game element
                  even when another entry displays the same numeric value.
                </p>
              </div>

              <h3>What a completed puzzle means</h3>
              <ol class="case-study__steps">
                <li>
                  <strong>Reveal the strip.</strong> Deduce every hidden value while
                  preserving the strip's ordering rules.
                </li>
                <li>
                  <strong>Resolve the grid.</strong> Assign operands and operators
                  to the hidden expressions beneath each known result.
                </li>
                <li>
                  <strong>Validate the pairings.</strong> Use each strip entry once
                  for an addition and once for a multiplication across the board.
                </li>
              </ol>

              <h3>Play options</h3>
              <p>
                The current app groups generated play into Quick and Classic,
                while keeping the exact puzzle-size families explicit in the
                domain. Daily Challenge adds a deterministic, device-local
                challenge without requiring an account or a server.
              </p>
              <ul class="case-study__list">
                <li><strong>Quick:</strong> shorter generated challenges.</li>
                <li>
                  <strong>Classic:</strong> the original full-board challenge sizes.
                </li>
                <li>
                  <strong>Daily Challenge:</strong> one reproducible local-date puzzle
                  and completion history.
                </li>
              </ul>
            </section>

            <section
              id="implementation"
              class="case-study__section"
              aria-labelledby="implementation-title"
            >
              <p class="case-study__section-label">02 / implementation</p>
              <h2 id="implementation-title">A native Android implementation</h2>
              <div class="case-study__prose">
                <p>
                  NumPairs is built as a native Android application with Kotlin,
                  Jetpack Compose, Gradle Kotlin DSL, and Android Studio.
                  Compose provides the UI layer while the puzzle rules remain
                  independent of Android and persistence concerns.
                </p>
                <p>
                  The project keeps the app usable as a local product. There are
                  no user accounts, developer-operated gameplay servers, or
                  analytics in the current product contract; preferences,
                  progress, and challenge history are handled on the device.
                </p>
              </div>

              <div
                class="case-study__architecture"
                aria-label="NumPairs architecture layers"
              >
                {
                  architectureLayers.map((layer) => (
                    <article class="architecture-card">
                      <h3>
                        <code>{layer.name}</code>
                      </h3>
                      <p>{layer.description}</p>
                    </article>
                  ))
                }
              </div>
            </section>

            <section
              id="domain"
              class="case-study__section"
              aria-labelledby="domain-title"
            >
              <p class="case-study__section-label">03 / domain</p>
              <h2 id="domain-title">
                The rules live in an explicit domain model
              </h2>
              <div class="case-study__prose">
                <p>
                  The core uses a small ubiquitous language inspired by
                  domain-driven design. <code>Puzzle</code>, <code>Board</code>,
                  <code>Tile</code>, <code>Expression</code>,
                  <code>Operator</code>, and <code>Strip</code> describe the problem
                  directly instead of reducing it to UI state.
                </p>
                <p>
                  This separation keeps arithmetic validation, assignments, and
                  completion rules testable without Compose. It also makes an
                  important distinction explicit: two equal numbers can still be
                  different strip entries, so identity—not only displayed
                  value—controls usage and pairing.
                </p>
              </div>

              <div class="case-study__callout">
                <p class="case-study__callout-label">Design decision</p>
                <p>
                  A generated puzzle starts from a fully solved model. The app
                  then creates the player-facing state by masking expressions
                  and selected strip entries, keeping one authoritative source
                  for generation and validation.
                </p>
              </div>
            </section>

            <section
              id="generation"
              class="case-study__section"
              aria-labelledby="generation-title"
            >
              <p class="case-study__section-label">04 / generation</p>
              <h2 id="generation-title">Generate, assess, and validate</h2>
              <div class="case-study__prose">
                <p>
                  Puzzle generation is treated as a bounded search problem. A
                  profile describes the size, value constraints, result
                  constraints, masking shape, variety, and difficulty policy. A
                  candidate is only shown after it passes the shared validation
                  rules.
                </p>
                <p>
                  Difficulty assessment reasons about pair-to-result facts,
                  forced deductions, ambiguity, branching, and cross-pair usage.
                  The evaluator can reject unsatisfiable or trivial candidates
                  without becoming part of the Compose UI or changing the rules
                  used to complete a puzzle.
                </p>
              </div>

              <h3>Implemented generated profiles</h3>
              <ul
                class="case-study__tag-list"
                aria-label="Implemented generated profiles"
              >
                {generatedProfiles.map((profile) => <li>{profile}</li>)}
              </ul>

              <p>
                Generation receives explicit seeds and execution limits. That
                gives tests reproducible inputs, makes failure and cancellation
                observable, and prevents an unbounded search from becoming a
                hidden dependency of the player-facing flow.
              </p>
            </section>

            <section
              id="delivery"
              class="case-study__section"
              aria-labelledby="delivery-title"
            >
              <p class="case-study__section-label">05 / delivery</p>
              <h2 id="delivery-title">
                Local state, recoverable sessions, deliberate delivery
              </h2>
              <div class="case-study__prose">
                <p>
                  Generated play persists an exact session snapshot rather than
                  regenerating a historical puzzle from its seed. The current
                  puzzle, progress, mode, profile, and seed stay tied to the
                  stored session, so process death does not silently change the
                  challenge being resumed.
                </p>
                <p>
                  Daily Challenge uses a separate versioned local aggregate for
                  the active puzzle and completion history. Normal generated
                  play and Daily progress can therefore be resumed
                  independently, and a replacement is stored before it becomes
                  playable.
                </p>
              </div>

              <h3>Evidence in the repository</h3>
              <ul class="case-study__list">
                <li>
                  Deterministic unit tests cover domain rules, profiles,
                  generation, persistence codecs, and session transitions.
                </li>
                <li>
                  Compose and instrumented tests exercise navigation, game
                  semantics, accessibility behavior, Daily Challenge, and
                  generated-play flows.
                </li>
                <li>
                  Product requirements, architecture decisions, and delivery
                  documentation are kept alongside the implementation.
                </li>
              </ul>
            </section>

            <div class="case-study__closing">
              <p>
                NumPairs is a small game with deliberately explicit engineering
                boundaries: a local Android product, a domain model that owns
                puzzle rules, and a generator whose output is validated before
                play.
              </p>
              <TextLink href="/" variant="standalone"
                >← Back to portfolio</TextLink
              >
            </div>
          </div>

          <aside class="case-study__sidebar">
            <nav
              class="case-study__sidebar-block"
              aria-labelledby="case-study-navigation-title"
            >
              <h2 id="case-study-navigation-title">On this page</h2>
              <ol>
                {
                  sections.map((section) => (
                    <li>
                      <a href={`#${section.id}`}>{section.label}</a>
                    </li>
                  ))
                }
              </ol>
            </nav>

            <section
              class="case-study__sidebar-block"
              aria-labelledby="resources-title"
            >
              <h2 id="resources-title">Resources</h2>
              <ul class="case-study__resources">
                <li>
                  <TextLink
                    href={sourceUrl}
                    variant="inline"
                    target="_blank"
                    rel="noreferrer"
                  >
                    Source repository
                  </TextLink>
                  <span>Android app · MIT License</span>
                </li>
                <li>
                  <TextLink href="/numpairs/privacy-policy/" variant="inline">
                    Privacy Policy
                  </TextLink>
                  <span>Product and website data practices</span>
                </li>
                <li>
                  <span class="case-study__resource-title">Google Play</span>
                  <span>Listing not yet published</span>
                </li>
              </ul>
            </section>

            <section
              class="case-study__sidebar-block"
              aria-labelledby="facts-title"
            >
              <h2 id="facts-title">At a glance</h2>
              <dl class="case-study__facts">
                <div>
                  <dt>App type</dt>
                  <dd>Native Android</dd>
                </div>
                <div>
                  <dt>Minimum API</dt>
                  <dd>26</dd>
                </div>
                <div>
                  <dt>Data model</dt>
                  <dd>Local persistence</dd>
                </div>
                <div>
                  <dt>Runtime service</dt>
                  <dd>None required</dd>
                </div>
              </dl>
            </section>
          </aside>
        </div>
      </article>
    </PageContainer>
  </div>
</BaseLayout>

<style>
  .case-study-page {
    background: var(--color-bg-deep);
  }

  .case-study {
    padding-block: var(--space-10) var(--space-12);
  }

  .case-study__hero {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  .case-study__hero-content {
    display: grid;
    max-inline-size: 76ch;
    gap: var(--space-4);
  }

  .case-study__eyebrow,
  .case-study__section-label,
  .case-study__callout-label {
    color: var(--color-text-secondary);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--letter-spacing-uppercase);
    line-height: var(--type-label-line-height);
    text-transform: uppercase;
  }

  .case-study__category {
    color: var(--color-accent-default);
    font-size: var(--type-meta-size);
    font-weight: var(--type-meta-weight);
    line-height: var(--type-meta-line-height);
  }

  .case-study h1 {
    color: var(--color-text-primary);
    font-size: var(--type-display-size);
    font-weight: var(--type-display-weight);
    line-height: var(--type-display-line-height);
  }

  .case-study__lead {
    max-inline-size: 72ch;
    color: var(--color-text-secondary);
    font-size: var(--type-title-size);
    line-height: var(--type-h3-line-height);
  }

  .case-study__actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
    margin-block-start: var(--space-3);
  }

  .case-study__metadata,
  .case-study__facts {
    display: grid;
    margin: 0;
    border-block-start: var(--border-default) var(--color-border-subtle);
  }

  .case-study__metadata {
    max-inline-size: 760px;
  }

  .case-study__metadata > div,
  .case-study__facts > div {
    display: grid;
    grid-template-columns: minmax(112px, 0.55fr) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-end: var(--border-default) var(--color-border-subtle);
  }

  .case-study__metadata dt,
  .case-study__facts dt {
    color: var(--color-text-tertiary);
    font-size: var(--type-meta-size);
    font-weight: var(--type-meta-weight);
    line-height: var(--type-meta-line-height);
  }

  .case-study__metadata dd,
  .case-study__facts dd {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--type-body-sm-size);
    line-height: var(--type-body-sm-line-height);
  }

  .case-study__visual {
    margin: var(--space-11) 0;
  }

  .case-study__visual svg {
    display: block;
    inline-size: 100%;
    min-inline-size: 760px;
    block-size: auto;
    border: var(--border-default) var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .case-study__visual {
    overflow-x: auto;
  }

  .case-study__visual figcaption {
    max-inline-size: var(--content-prose-max);
    margin-block-start: var(--space-3);
    color: var(--color-text-tertiary);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-line-height);
  }

  .case-study__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(236px, 280px);
    gap: var(--space-11);
    align-items: start;
  }

  .case-study__main {
    min-inline-size: 0;
  }

  .case-study__section {
    max-inline-size: 80ch;
    padding-block: var(--space-10);
    border-block-start: var(--border-default) var(--color-border-subtle);
    scroll-margin-block-start: var(--anchor-scroll-offset);
  }

  .case-study__section:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .case-study__section h2 {
    margin-block: var(--space-3) var(--space-6);
    color: var(--color-text-primary);
  }

  .case-study__section h3 {
    margin-block: var(--space-8) var(--space-3);
    color: var(--color-text-primary);
  }

  .case-study__prose,
  .case-study__section > p:not(.case-study__section-label),
  .case-study__section > ul,
  .case-study__section > ol {
    color: var(--color-text-secondary);
  }

  .case-study__prose,
  .case-study__steps,
  .case-study__list {
    display: grid;
    gap: var(--space-4);
  }

  .case-study__prose p,
  .case-study__section > p:not(.case-study__section-label) {
    max-inline-size: var(--content-prose-max);
  }

  .case-study__steps,
  .case-study__list {
    margin-block: var(--space-4) 0;
    padding-inline-start: var(--space-6);
  }

  .case-study__steps li,
  .case-study__list li {
    padding-inline-start: var(--space-2);
  }

  .case-study strong,
  .case-study code {
    color: var(--color-text-primary);
  }

  .case-study code {
    padding-inline: 0.25em;
    border-radius: var(--radius-sm);
    background: var(--color-surface-default);
    font-size: 0.95em;
  }

  .case-study__architecture {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  .architecture-card {
    padding: var(--space-5);
    border: var(--border-default) var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-surface-default);
  }

  .architecture-card h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--type-title-size);
    line-height: var(--type-title-line-height);
  }

  .architecture-card p {
    color: var(--color-text-secondary);
    font-size: var(--type-body-sm-size);
    line-height: var(--type-body-sm-line-height);
  }

  .case-study__callout {
    margin-block-start: var(--space-7);
    padding: var(--space-6);
    border-inline-start: 3px solid var(--color-accent-default);
    background: var(--color-surface-default);
  }

  .case-study__callout > p:last-child {
    margin-block-start: var(--space-3);
    color: var(--color-text-secondary);
  }

