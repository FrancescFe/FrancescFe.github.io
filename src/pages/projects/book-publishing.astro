              <dt>Project type</dt>
              <dd>In-house back office</dd>
            </div>
            <div>
              <dt>Client</dt>
              <dd>Editorial Denes</dd>
            </div>
            <div>
              <dt>Status</dt>
              <dd>In production</dd>
            </div>
            <div>
              <dt>Core stack</dt>
              <dd>Kotlin · Spring Boot · PostgreSQL · OpenAPI</dd>
            </div>
          </dl>
        </header>

        <figure class="book-publishing__visual">
          <svg
