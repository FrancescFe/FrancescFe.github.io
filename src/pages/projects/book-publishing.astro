                    variant="inline"
                    target="_blank"
                    rel="noreferrer"
                  >
                    Documentation
                  </TextLink>
                  <span>Project and engineering documentation</span>
                </li>
              </ul>
            </section>

            <section
              class="book-publishing__sidebar-block"
              aria-labelledby="facts-title"
            >
              <h2 id="facts-title">At a glance</h2>
              <dl class="book-publishing__facts">
                <div>
                  <dt>Platform</dt>
                  <dd>In-house publishing back office</dd>
                </div>
                <div>
                  <dt>Client</dt>
                  <dd>Editorial Denes</dd>
                </div>
                <div>
                  <dt>Boundary</dt>
                  <dd>Versioned OpenAPI contract</dd>
                </div>
                <div>
