---
import PageContainer from "../components/PageContainer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "FrancescFe Portfolio";
const description = "The technical portfolio of FrancescFe.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  currentPath="/"
  headerVariant="default"
  footerVariant="full"
  showScrollToTop
  social={{ title, description, type: "website" }}
>
  <PageContainer>
    <section class="foundation" aria-labelledby="foundation-title">
      <div class="foundation__content">
        <p class="foundation__label">Foundation ready</p>
        <h1 id="foundation-title">FrancescFe Portfolio</h1>
        <p class="foundation__summary">
          The global design tokens and shared responsive shell are ready for the
          portfolio experience.
        </p>
      </div>
    </section>
  </PageContainer>
</BaseLayout>

<style>
  .foundation {
    display: grid;
    min-block-size: 100vh;
    padding-block: var(--space-10);
    align-items: center;
  }

  .foundation__content {
    display: grid;
    max-inline-size: var(--content-prose-max);
    gap: var(--space-4);
  }

  .foundation__label {
    color: var(--color-accent-default);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--letter-spacing-uppercase);
    line-height: var(--type-label-line-height);
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--type-display-size);
    font-weight: var(--type-display-weight);
    line-height: var(--type-display-line-height);
  }

  .foundation__summary {
    max-inline-size: var(--content-prose-max);
    color: var(--color-text-secondary);
  }
</style>
