---
import githubIcon from "../assets/icons/brands/github-invertocat-white.svg";
import linkedinIcon from "../assets/icons/brands/linkedin-in-white.svg";
import { SITE } from "../config/site";
import type { HeaderNavigationItem, SiteHeaderVariant } from "../types/shell";
import PageContainer from "./PageContainer.astro";
import TextLink from "./TextLink.astro";

interface Props {
  variant?: SiteHeaderVariant;
  currentPath?: string;
  navigation?: readonly HeaderNavigationItem[];
  secondaryLabel?: string;
}

const {
  variant = "default",
  currentPath = Astro.url.pathname,
  navigation = [],
  secondaryLabel = SITE.secondaryIdentity,
} = Astro.props;

const professionalProfiles = [
  {
    label: "GitHub profile",
    href: SITE.socialLinks.github,
    icon: githubIcon,
  },
  {
    label: "LinkedIn profile",
    href: SITE.socialLinks.linkedin,
    icon: linkedinIcon,
  },
] as const;
---

<header class:list={["site-header", `site-header--${variant}`]}>
  <PageContainer>
    <div class="site-header__inner">
      <div class="site-header__identity">
        <TextLink
          href="/"
          variant="identity"
          selected={currentPath === "/"}
          aria-label={`${SITE.name} homepage`}
        >
          <span class="site-header__bracket" aria-hidden="true">{"{"}</span>
          <span>{SITE.identity}</span>
          <span class="site-header__bracket" aria-hidden="true">{"}"}</span>
        </TextLink>

        {
          variant === "default" && secondaryLabel && (
            <span class="site-header__secondary">{secondaryLabel}</span>
          )
        }
      </div>

      <div class="site-header__actions">
        {
          navigation.length > 0 && (
            <nav
              class="site-header__navigation"
              aria-label="Primary navigation"
            >
              <ul>
                {navigation.map((item) => (
                  <li>
                    <TextLink
                      href={item.href}
                      variant="navigation"
                      selected={currentPath === item.href}
                      disabled={item.disabled}
                    >
                      {item.label}
                    </TextLink>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <nav aria-label="Professional profiles">
          <ul class="site-header__profiles">
            {
              professionalProfiles.map((profile) => (
                <li>
                  <a
                    class="site-header__profile-link"
                    href={profile.href}
                    aria-label={profile.label}
                    rel="me"
                  >
                    <img
                      src={profile.icon.src}
                      alt=""
                      width={profile.icon.width}
                      height={profile.icon.height}
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </PageContainer>
</header>

<style>
  .site-header {
    border-block-end: var(--border-default) var(--color-border-subtle);
    background: var(--color-bg-canvas);
  }

  .site-header__inner {
    display: flex;
    min-block-size: 92px;
    gap: var(--space-5);
    align-items: center;
    justify-content: space-between;
  }

  .site-header--compact .site-header__inner {
    min-block-size: 64px;
  }

  .site-header__identity {
    display: flex;
    min-inline-size: 0;
    gap: var(--space-5);
    align-items: center;
  }

  .site-header__bracket {
    color: var(--color-accent-default);
  }

  .site-header__secondary {
    color: var(--color-text-secondary);
    font-size: var(--type-meta-size);
    font-weight: var(--type-meta-weight);
    line-height: var(--type-meta-line-height);
    white-space: nowrap;
  }

  .site-header__actions,
  .site-header__navigation ul,
  .site-header__profiles {
    display: flex;
    align-items: center;
  }

  .site-header__actions {
    gap: var(--space-3);
  }

  .site-header__navigation ul,
  .site-header__profiles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__navigation ul {
    gap: var(--space-3);
  }

  .site-header__profiles {
    gap: var(--space-1);
  }

  .site-header__profile-link {
    display: inline-grid;
    min-block-size: var(--interactive-target-min);
    min-inline-size: var(--interactive-target-min);
    border-radius: var(--radius-sm);
    place-items: center;
    text-decoration: none;
    transition: background-color var(--motion-duration-fast)
      var(--motion-easing-standard);
  }

  .site-header__profile-link:hover {
    background: var(--color-surface-hover);
  }

  .site-header__profile-link:active {
    background: var(--color-surface-default);
  }

  .site-header__profile-link img {
    inline-size: var(--space-5);
    block-size: var(--space-5);
    object-fit: contain;
    opacity: 0.68;
    transition: opacity var(--motion-duration-fast)
      var(--motion-easing-standard);
  }

  .site-header__profile-link:hover img {
    opacity: 1;
  }

  .site-header__profile-link:active img {
    opacity: 0.8;
  }

  @media (max-width: 767px) {
    .site-header__inner {
      min-block-size: 76px;
      gap: var(--space-3);
      flex-wrap: wrap;
    }

    .site-header__secondary {
      display: none;
    }

    .site-header--compact .site-header__inner {
      min-block-size: 64px;
    }
  }
</style>
