---
import { SITE } from "../config/site";
import type { HeaderNavigationItem, SiteHeaderVariant } from "../types/shell";
import PageContainer from "./PageContainer.astro";
import TextLink from "./TextLink.astro";

interface Props {
  variant?: SiteHeaderVariant;
  currentPath?: string;
  navigation?: readonly HeaderNavigationItem[];
  secondaryLabel?: string;
}

const {
  variant = "default",
  currentPath = Astro.url.pathname,
  navigation = [],
  secondaryLabel = SITE.secondaryIdentity,
} = Astro.props;

const professionalProfiles = [
  {
    label: "GitHub profile",
    href: SITE.socialLinks.github,
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C6.096 18.24 5.04 17.759 5.04 17.759c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "LinkedIn profile",
    href: SITE.socialLinks.linkedin,
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 4.128 0c0 1.14-.924 2.065-2.065 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z",
  },
] as const;
---

<header class:list={["site-header", `site-header--${variant}`]}>
  <PageContainer>
    <div class="site-header__inner">
      <div class="site-header__identity">
        <TextLink
          href="/"
          variant="identity"
          selected={currentPath === "/"}
          aria-label={`${SITE.name} homepage`}
        >
          <span class="site-header__bracket" aria-hidden="true">{"{"}</span>
          <span>{SITE.identity}</span>
          <span class="site-header__bracket" aria-hidden="true">{"}"}</span>
        </TextLink>

        {
          variant === "default" && secondaryLabel && (
            <span class="site-header__secondary">{secondaryLabel}</span>
          )
        }
      </div>

      <div class="site-header__actions">
        {
          navigation.length > 0 && (
            <nav
              class="site-header__navigation"
              aria-label="Primary navigation"
            >
              <ul>
                {navigation.map((item) => (
                  <li>
                    <TextLink
                      href={item.href}
                      variant="navigation"
                      selected={currentPath === item.href}
                      disabled={item.disabled}
                    >
                      {item.label}
                    </TextLink>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <nav aria-label="Professional profiles">
          <ul class="site-header__profiles">
            {
              professionalProfiles.map((profile) => (
                <li>
                  <a
                    class="site-header__profile-link"
                    href={profile.href}
                    aria-label={profile.label}
                    rel="me"
                  >
                    <svg
                      aria-hidden="true"
                      focusable="false"
                      viewBox="0 0 24 24"
                    >
                      <path d={profile.path} />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </PageContainer>
</header>

<style>
  .site-header {
    border-block-end: var(--border-default) var(--color-border-subtle);
    background: var(--color-bg-canvas);
  }

  .site-header__inner {
    display: flex;
    min-block-size: 92px;
    gap: var(--space-5);
    align-items: center;
    justify-content: space-between;
  }

  .site-header--compact .site-header__inner {
    min-block-size: 64px;
  }

  .site-header__identity {
    display: flex;
    min-inline-size: 0;
    gap: var(--space-5);
    align-items: center;
  }

  .site-header__bracket {
    color: var(--color-accent-default);
  }

  .site-header__secondary {
    color: var(--color-text-secondary);
    font-size: var(--type-meta-size);
    font-weight: var(--type-meta-weight);
    line-height: var(--type-meta-line-height);
    white-space: nowrap;
  }

  .site-header__actions,
  .site-header__navigation ul,
  .site-header__profiles {
    display: flex;
    align-items: center;
  }

  .site-header__actions {
    gap: var(--space-3);
  }

  .site-header__navigation ul,
  .site-header__profiles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__navigation ul {
    gap: var(--space-3);
  }

  .site-header__profiles {
    gap: var(--space-1);
  }

  .site-header__profile-link {
    display: inline-grid;
    min-block-size: var(--interactive-target-min);
    min-inline-size: var(--interactive-target-min);
    border-radius: var(--radius-sm);
    place-items: center;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      background-color var(--motion-duration-fast) var(--motion-easing-standard),
      color var(--motion-duration-fast) var(--motion-easing-standard);
  }

  .site-header__profile-link:hover {
    background: var(--color-surface-hover);
    color: var(--color-text-primary);
  }

  .site-header__profile-link:active {
    background: var(--color-surface-default);
    color: var(--color-text-secondary);
  }

  .site-header__profile-link svg {
    inline-size: var(--space-5);
    block-size: var(--space-5);
    fill: currentColor;
  }

  @media (max-width: 767px) {
    .site-header__inner {
      min-block-size: 76px;
      gap: var(--space-3);
      flex-wrap: wrap;
    }

    .site-header__secondary {
      display: none;
    }

    .site-header--compact .site-header__inner {
      min-block-size: 64px;
    }
  }
</style>
