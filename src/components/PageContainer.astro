---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...attributes } = Astro.props;
---

<div class:list={["page-container", className]} {...attributes}>
  <slot />
</div>

<style>
  .page-container {
    inline-size: min(
      100%,
      calc(
        var(--content-site-max) + var(--viewport-padding-inline) +
          var(--viewport-padding-inline)
      )
    );
    margin-inline: auto;
    padding-inline: var(--viewport-padding-inline);
  }
</style>
